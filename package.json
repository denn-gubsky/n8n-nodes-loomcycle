{
	"name": "@loomcycle/n8n-nodes-loomcycle-full",
	"version": "2.16.0",
	"publishConfig": {
		"access": "public"
	},
	"description": "FULL self-hosted edition of the loomcycle n8n nodes — superset of @loomcycle/n8n-nodes-loomcycle. Adds the langchain-based AI-Agent Tool sub-nodes (Memory / Channel / Sub-Agent / MCP Server / Document / Fact / Team Tool), SSE-push triggers, and the Run 'Wait for Completion' op that n8n Cloud verification disallows. 37 nodes total. NOT n8n-Cloud-verified — install manually on self-hosted n8n. Pairs with loomcycle ≥ v0.9.2 (Schedule + per-tool credentials ≥ v0.12.x; Webhook + A2A ≥ v0.14.x; interactive run steering ≥ v1.1.1; Volume ≥ v1.1; Path + Document ≥ v1.4; image input ≥ v1.7; turn-scoped cancel + interrupt decline ≥ v1.22; session replay ≥ v1.25; unified memory search ≥ v1.47; Fact + Document Source ≥ v1.54; Team ≥ v1.17.1; Usage ≥ v1.10, Erasure ≥ v1.45, Directory ≥ v1.46, User ≥ v1.50. Document / Fact need SQL Memory on the sidecar).",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"loomcycle",
		"agentic",
		"llm",
		"mcp",
		"agent"
	],
	"license": "MIT",
	"homepage": "https://github.com/denn-gubsky/n8n-nodes-loomcycle#readme",
	"author": {
		"name": "Dennis Gubsky",
		"email": "denn@loomcycle.dev"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/denn-gubsky/n8n-nodes-loomcycle.git"
	},
	"bugs": {
		"url": "https://github.com/denn-gubsky/n8n-nodes-loomcycle/issues"
	},
	"main": "index.js",
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "node scripts/build.cjs && gulp build:icons",
		"build:icons": "gulp build:icons",
		"dev": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"**/*.{ts,json,md,yml}\"",
		"lint": "eslint . --ext .ts",
		"lintfix": "eslint . --ext .ts --fix",
		"prepublishOnly": "npm run build && eslint . --ext .ts -c .eslintrc.prepublish.js",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/LoomCycleApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/LoomCycleRun/LoomCycleRun.node.js",
			"dist/nodes/LoomCycleMemory/LoomCycleMemory.node.js",
			"dist/nodes/LoomCycleChannel/LoomCycleChannel.node.js",
			"dist/nodes/LoomCycleAgentDef/LoomCycleAgentDef.node.js",
			"dist/nodes/LoomCycleSkillDef/LoomCycleSkillDef.node.js",
			"dist/nodes/LoomCycleMcpServerDef/LoomCycleMcpServerDef.node.js",
			"dist/nodes/LoomCycleSchedule/LoomCycleSchedule.node.js",
			"dist/nodes/LoomCycleHook/LoomCycleHook.node.js",
			"dist/nodes/LoomCycleWebhook/LoomCycleWebhook.node.js",
			"dist/nodes/LoomCycleA2aAgent/LoomCycleA2aAgent.node.js",
			"dist/nodes/LoomCycleA2aServerCard/LoomCycleA2aServerCard.node.js",
			"dist/nodes/LoomCycleInterruption/LoomCycleInterruption.node.js",
			"dist/nodes/LoomCycleLlm/LoomCycleLlm.node.js",
			"dist/nodes/LoomCycleMemoryBackend/LoomCycleMemoryBackend.node.js",
			"dist/nodes/LoomCycleOperatorToken/LoomCycleOperatorToken.node.js",
			"dist/nodes/LoomCycleSnapshot/LoomCycleSnapshot.node.js",
			"dist/nodes/LoomCycleVolume/LoomCycleVolume.node.js",
			"dist/nodes/LoomCyclePath/LoomCyclePath.node.js",
			"dist/nodes/LoomCycleDocument/LoomCycleDocument.node.js",
			"dist/nodes/LoomCycleFact/LoomCycleFact.node.js",
			"dist/nodes/LoomCycleDocumentSource/LoomCycleDocumentSource.node.js",
			"dist/nodes/LoomCycleTeam/LoomCycleTeam.node.js",
			"dist/nodes/LoomCycleDirectory/LoomCycleDirectory.node.js",
			"dist/nodes/LoomCycleErasure/LoomCycleErasure.node.js",
			"dist/nodes/LoomCycleUser/LoomCycleUser.node.js",
			"dist/nodes/LoomCycleUsage/LoomCycleUsage.node.js",
			"dist/nodes/LoomCycleRunCompleted/LoomCycleRunCompleted.node.js",
			"dist/nodes/LoomCycleChannelMessage/LoomCycleChannelMessage.node.js",
			"dist/nodes/LoomCycleInterruptPending/LoomCycleInterruptPending.node.js",
			"dist/nodes/LoomCycleChatModel/LoomCycleChatModel.node.js",
			"dist/nodes/LoomCycleMemoryTool/LoomCycleMemoryTool.node.js",
			"dist/nodes/LoomCycleChannelTool/LoomCycleChannelTool.node.js",
			"dist/nodes/LoomCycleSubAgentTool/LoomCycleSubAgentTool.node.js",
			"dist/nodes/LoomCycleMcpServerTool/LoomCycleMcpServerTool.node.js",
			"dist/nodes/LoomCycleDocumentTool/LoomCycleDocumentTool.node.js",
			"dist/nodes/LoomCycleFactTool/LoomCycleFactTool.node.js",
			"dist/nodes/LoomCycleTeamTool/LoomCycleTeamTool.node.js"
		]
	},
	"peerDependencies": {
		"@langchain/core": ">=0.3.0",
		"n8n-workflow": ">=1.82.0 <2.0.0",
		"zod": ">=3.22.0"
	},
	"devDependencies": {
		"@langchain/core": "^0.3.0",
		"@loomcycle/client": "^1.55.0",
		"@types/node": "^20.14.0",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"@vitest/coverage-v8": "^3.0.0",
		"esbuild": "^0.28.0",
		"eslint": "^8.57.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.0",
		"gulp": "^5.0.0",
		"n8n-workflow": "^1.82.0",
		"prettier": "^3.3.0",
		"typescript": "^5.4.0",
		"vitest": "^3.0.0",
		"zod": "^3.22.0"
	}
}
